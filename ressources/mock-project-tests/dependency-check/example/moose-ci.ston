MooseCIConfig {
	#projectLanguage : #java,
	#metrics : [
		#packages,
		#classes
	],
	#rules : [
		#too_many_parameters : {
			#parameters : 10
		},
		#large_class : {
			#attributes : 15,
			#methods : 20
		},
		#unused_local_variable,
		#unused_parameter,
	],
	#architecture : {
		#modules : { 
			#ui: '.ui\\..*',
			#domain: '.domain\\..*',
			#infra: '.infra\\..*' 
		},
    	#constraints : [
			'domain cannot depend infra',
			'ui must depend domain',
			'ui canOnly depend domain'
    	]
	},
	#outputFormats : [
		#json
	],
	#outputPath : '.moose-ci/report',
	#visualizations : [ ],
	#isRemote : false
}